# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

AOL_EMAIL=you@aol.com

# AOL requires a generated "app password" for third-party IMAP access;
# your normal AOL login password will not work here.
# Generate one at: AOL Account Security settings -> App passwords
AOL_APP_PASSWORD=

# Optional: mailbox to check (default: INBOX)
# AOL_MAILBOX=INBOX
